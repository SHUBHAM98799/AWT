        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        },
        "description": "Retrieves all tasks. Demonstrates cache miss on first run, and cache hits on subsequent runs."
      }
    },
    {
      "name": "02. GET Single Task by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
